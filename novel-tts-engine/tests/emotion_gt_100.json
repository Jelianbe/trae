[
  {"id": "emo_001", "text": "你给我滚出去！", "emotion_class": "excited", "emotion_label": "anger", "style": "都市"},
  {"id": "emo_002", "text": "混蛋！你怎么能这样！", "emotion_class": "excited", "emotion_label": "anger", "style": "都市"},
  {"id": "emo_003", "text": "放肆！谁给你的胆子！", "emotion_class": "excited", "emotion_label": "anger", "style": "历史"},
  {"id": "emo_004", "text": "滚开！别烦我！", "emotion_class": "excited", "emotion_label": "anger", "style": "都市"},
  {"id": "emo_005", "text": "以神之名，净化你！", "emotion_class": "excited", "emotion_label": "anger", "style": "西幻"},
  {"id": "emo_006", "text": "萧炎，你太放肆了！", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_007", "text": "三十年河东，三十年河西！", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_008", "text": "这次让你死无葬身之地！", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_009", "text": "你背叛了整个帝国！", "emotion_class": "excited", "emotion_label": "anger", "style": "西幻"},
  {"id": "emo_010", "text": "你这是自寻死路！", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_011", "text": "哈哈哈，太好了！", "emotion_class": "excited", "emotion_label": "joy", "style": "都市"},
  {"id": "emo_012", "text": "太好了，我们赢了！", "emotion_class": "excited", "emotion_label": "joy", "style": "都市"},
  {"id": "emo_013", "text": "哈哈哈，这就是你的力量？", "emotion_class": "excited", "emotion_label": "joy", "style": "西幻"},
  {"id": "emo_014", "text": "这简直是完美的！", "emotion_class": "excited", "emotion_label": "joy", "style": "都市"},
  {"id": "emo_015", "text": "这可真是大喜事啊！", "emotion_class": "excited", "emotion_label": "joy", "style": "历史"},
  {"id": "emo_016", "text": "哼，就这点本事？", "emotion_class": "excited", "emotion_label": "joy", "style": "修仙"},
  {"id": "emo_017", "text": "这就是我梦寐以求的天级功法！", "emotion_class": "excited", "emotion_label": "joy", "style": "修仙"},
  {"id": "emo_018", "text": "冠军！我们是冠军！", "emotion_class": "excited", "emotion_label": "joy", "style": "都市"},
  {"id": "emo_019", "text": "你终于回来了。", "emotion_class": "subdued", "emotion_label": "joy", "style": "都市"},
  {"id": "emo_020", "text": "我们竟然真的做到了。", "emotion_class": "excited", "emotion_label": "joy", "style": "都市"},
  {"id": "emo_021", "text": "天哪！龙竟然复活了！", "emotion_class": "excited", "emotion_label": "surprise", "style": "西幻"},
  {"id": "emo_022", "text": "怎么可能会有这种事？", "emotion_class": "excited", "emotion_label": "surprise", "style": "都市"},
  {"id": "emo_023", "text": "药老，您还活着！", "emotion_class": "excited", "emotion_label": "surprise", "style": "修仙"},
  {"id": "emo_024", "text": "这……这是什么？", "emotion_class": "excited", "emotion_label": "surprise", "style": "西幻"},
  {"id": "emo_025", "text": "难道是你？怎么会！", "emotion_class": "excited", "emotion_label": "surprise", "style": "都市"},
  {"id": "emo_026", "text": "太可怕了！斗皇的气息！", "emotion_class": "excited", "emotion_label": "surprise", "style": "修仙"},
  {"id": "emo_027", "text": "你竟然还记得我。", "emotion_class": "excited", "emotion_label": "surprise", "style": "历史"},
  {"id": "emo_028", "text": "难道太子殿下真的……", "emotion_class": "excited", "emotion_label": "surprise", "style": "历史"},
  {"id": "emo_029", "text": "唉，这一切都结束了……", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_030", "text": "不……不要离开我……", "emotion_class": "subdued", "emotion_label": "sadness", "style": "西幻"},
  {"id": "emo_031", "text": "父亲……我对不起你……", "emotion_class": "subdued", "emotion_label": "sadness", "style": "修仙"},
  {"id": "emo_032", "text": "呜呜呜，我好难过", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_033", "text": "怎会如此……我的儿啊……", "emotion_class": "subdued", "emotion_label": "sadness", "style": "历史"},
  {"id": "emo_034", "text": "我连最后一面都没见到……", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_035", "text": "你走吧，趁我还没后悔。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_036", "text": "我们……回不去了。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "西幻"},
  {"id": "emo_037", "text": "别过来！求你别过来！", "emotion_class": "subdued", "emotion_label": "fear", "style": "都市"},
  {"id": "emo_038", "text": "我害怕……你别伤害我", "emotion_class": "subdued", "emotion_label": "fear", "style": "都市"},
  {"id": "emo_039", "text": "他浑身发抖，连剑都拿不稳", "emotion_class": "subdued", "emotion_label": "fear", "style": "西幻"},
  {"id": "emo_040", "text": "恐怖的气息，是斗皇！", "emotion_class": "subdued", "emotion_label": "fear", "style": "修仙"},
  {"id": "emo_041", "text": "你……你不要过来！", "emotion_class": "subdued", "emotion_label": "fear", "style": "修仙"},
  {"id": "emo_042", "text": "饶命……将军饶命……", "emotion_class": "subdued", "emotion_label": "fear", "style": "历史"},
  {"id": "emo_043", "text": "快跑！它醒了！", "emotion_class": "excited", "emotion_label": "fear", "style": "西幻"},
  {"id": "emo_044", "text": "他走进了房间。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_045", "text": "今天天气不错。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_046", "text": "你吃饭了吗？", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_047", "text": "我愿意为你效忠。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "西幻"},
  {"id": "emo_048", "text": "走吧，我们回去。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_049", "text": "这是清单上要采买的货物。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "历史"},
  {"id": "emo_050", "text": "这条河去年还在这里。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "历史"},
  {"id": "emo_051", "text": "臣有本奏。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "历史"},
  {"id": "emo_052", "text": "末将愿往！", "emotion_class": "excited", "emotion_label": "anger", "style": "历史"},
  {"id": "emo_053", "text": "陛下三思啊！", "emotion_class": "excited", "emotion_label": "sadness", "style": "历史"},
  {"id": "emo_054", "text": "罪臣知罪。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "历史"},
  {"id": "emo_055", "text": "乱臣贼子，人人得而诛之！", "emotion_class": "excited", "emotion_label": "anger", "style": "历史"},
  {"id": "emo_056", "text": "圣上息怒！", "emotion_class": "subdued", "emotion_label": "fear", "style": "历史"},
  {"id": "emo_057", "text": "此乃天意，非人力可为。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "历史"},
  {"id": "emo_058", "text": "愿降。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "历史"},
  {"id": "emo_059", "text": "儿臣遵旨。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "历史"},
  {"id": "emo_060", "text": "将军！粮草被劫了！", "emotion_class": "excited", "emotion_label": "fear", "style": "历史"},
  {"id": "emo_061", "text": "可曾想过今日？", "emotion_class": "subdued", "emotion_label": "anger", "style": "历史"},
  {"id": "emo_062", "text": "我等这一天，等了十年。", "emotion_class": "subdued", "emotion_label": "anger", "style": "历史"},
  {"id": "emo_063", "text": "那就按你说的办。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_064", "text": "茶叶在第二个柜子里。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_065", "text": "他姓王，单名一个岩字。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_066", "text": "明日的宴席设在翠云轩。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "历史"},
  {"id": "emo_067", "text": "从这儿到镇上要走半个时辰。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "历史"},
  {"id": "emo_068", "text": "结界还需要一炷香的时间才能修复。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "修仙"},
  {"id": "emo_069", "text": "你把那份卷宗递给我。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_070", "text": "你们先退下吧。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "历史"},
  {"id": "emo_071", "text": "下个路口左转就是了。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_072", "text": "我知道了。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_073", "text": "是啊，你说的都对。", "emotion_class": "subdued", "emotion_label": "anger", "style": "都市"},
  {"id": "emo_074", "text": "这可是天大的好事啊。", "emotion_class": "excited", "emotion_label": "joy", "style": "都市"},
  {"id": "emo_075", "text": "天哪，你竟然来了。", "emotion_class": "excited", "emotion_label": "surprise", "style": "都市"},
  {"id": "emo_076", "text": "你可真有本事。", "emotion_class": "subdued", "emotion_label": "anger", "style": "都市"},
  {"id": "emo_077", "text": "别走，求你别走。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_078", "text": "你这是在威胁我？", "emotion_class": "subdued", "emotion_label": "fear", "style": "都市"},
  {"id": "emo_079", "text": "恭喜啊，如愿以偿了。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_080", "text": "就让我看看你究竟有多强。", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_081", "text": "你不该来这里的。", "emotion_class": "subdued", "emotion_label": "fear", "style": "西幻"},
  {"id": "emo_082", "text": "没想到会是你，我早该猜到的。", "emotion_class": "subdued", "emotion_label": "surprise", "style": "西幻"},
  {"id": "emo_083", "text": "你们魔教，人人得而诛之。", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_084", "text": "我竟然把一个叛徒当成了亲弟弟。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "历史"},
  {"id": "emo_085", "text": "你敢背叛我？", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_086", "text": "不必管我！你们快走！", "emotion_class": "excited", "emotion_label": "fear", "style": "修仙"},
  {"id": "emo_087", "text": "原来如此……我明白了。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_088", "text": "你……真的不后悔？", "emotion_class": "subdued", "emotion_label": "sadness", "style": "都市"},
  {"id": "emo_089", "text": "你还没明白吗！", "emotion_class": "excited", "emotion_label": "anger", "style": "都市"},
  {"id": "emo_090", "text": "你确定不去吗？机会真的很难得。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "都市"},
  {"id": "emo_091", "text": "神也没有抛弃我，是我抛弃了神。", "emotion_class": "subdued", "emotion_label": "anger", "style": "西幻"},
  {"id": "emo_092", "text": "谁都别想从我手里把它抢走。", "emotion_class": "excited", "emotion_label": "anger", "style": "都市"},
  {"id": "emo_093", "text": "散！", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_094", "text": "你可知道，我等这一刻等了多久？", "emotion_class": "excited", "emotion_label": "anger", "style": "修仙"},
  {"id": "emo_095", "text": "晚辈告辞。", "emotion_class": "neutral", "emotion_label": "neutral", "style": "修仙"},
  {"id": "emo_096", "text": "长老，此人不能留！", "emotion_class": "excited", "emotion_label": "fear", "style": "修仙"},
  {"id": "emo_097", "text": "吾等誓死追随将军！", "emotion_class": "excited", "emotion_label": "anger", "style": "历史"},
  {"id": "emo_098", "text": "即日起，你我恩断义绝。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "修仙"},
  {"id": "emo_099", "text": "来得正好。", "emotion_class": "excited", "emotion_label": "joy", "style": "修仙"},
  {"id": "emo_100", "text": "光明终会降临。", "emotion_class": "subdued", "emotion_label": "sadness", "style": "西幻"}
]
