# Novel-TTS-Engine 环境变量配置示例
# 复制此文件为 .env 并修改相应值
# 所有值均有合理默认值，仅按需覆盖

# ===== 基础设施 =====

# 数据库路径（默认: 项目根目录/novel_tts.db）
NOVEL_TTS_DB_PATH=novel_tts.db

# 结果缓存容量（默认: 200）
# 最多缓存多少本书的分析结果
MAX_RESULT_CACHE_SIZE=200

# ===== 流水线阈值配置 =====

# 情绪提取窗口大小（字符数，默认: 20）
# 用于提取对话周围情绪信号的字符窗口
EMOTION_EXTRACT_WINDOW=20

# 对话情绪置信度阈值（默认: 0.5）
# 对话类型句子的情绪标注最低置信度
DIALOGUE_EMOTION_CONFIDENCE_THRESHOLD=0.5

# 旁白情绪置信度阈值（默认: 0.4）
# 旁白类型句子的情绪标注最低置信度
NARRATION_EMOTION_CONFIDENCE_THRESHOLD=0.4

# 角色最低置信度（默认: 0.5）
# 角色识别的最低置信度要求
CHARACTER_MIN_CONFIDENCE=0.5

# 上下文提示置信度阈值（默认: 0.3）
# 从上下文推断说话人时的最低置信度
CONTEXT_HINT_CONFIDENCE_THRESHOLD=0.3

# 情绪低分阈值（默认: 0.25）
# 低于此值的情绪信号被认为是弱信号
EMOTION_LOW_SCORE_THRESHOLD=0.25

# ===== 近因衰减配置 =====

# 最近说话人衰减量（默认: 0.25）
# 连续对话中最近说话人的衰减量，避免粘着效应
RECENCY_DECAY_RECENT=0.25

# 第二近说话人衰减量（默认: 0.15）
RECENCY_DECAY_SECOND=0.15

# 其他说话人衰减量（默认: 0.08）
RECENCY_DECAY_OTHER=0.08

# ===== 角色频率衰减配置 =====

# 活动度衰减因子（默认: 0.05）
# 长时间未活动的角色权重衰减系数
ACTIVITY_DECAY_FACTOR=0.05

# 活动度增量（默认: 1.0）
# 每次活动增加的权重
ACTIVITY_INCREMENT=1.0

# ===== 对话边界检测 =====

# 说话动词锚点窗口（字符数，默认: 50）
# 说话动词周围用于提取说话人名的字符窗口
SPEECH_VERB_ANCHOR_WINDOW=50

# ===== 角色候选池过滤 =====

# 角色最低出现频次（默认: 5）
# 角色进入候选人池的最低出现频次
CHARACTER_ELIGIBLE_MIN_FREQ=5
